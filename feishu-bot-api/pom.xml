<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.bluemountain</groupId>
        <artifactId>feishu-bot</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>feishu-bot-api</artifactId>
    <name>feishu-bot-api</name>
    <description>API 对外接口层：飞书 Webhook 端点、管理后台 REST API、应用入口</description>

    <dependencies>
        <!-- 核心业务（传递全部依赖） -->
        <dependency>
            <groupId>com.bluemountain</groupId>
            <artifactId>feishu-bot-core</artifactId>
        </dependency>

        <!-- 基础设施（Entity + Mapper） -->
        <dependency>
            <groupId>com.bluemountain</groupId>
            <artifactId>feishu-bot-infrastructure</artifactId>
        </dependency>

        <!-- Spring MVC（Webhook + REST API） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Spring WebFlux（高并发 Webhook 端点） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webflux</artifactId>
        </dependency>

        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
