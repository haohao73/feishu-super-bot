<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.bluemountain</groupId>
        <artifactId>feishu-bot</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>feishu-bot-core</artifactId>
    <name>feishu-bot-core</name>
    <description>核心业务模块：指令路由、多轮对话管理、各指令处理器、消息模板</description>

    <dependencies>
        <!-- 公共模块 -->
        <dependency>
            <groupId>com.bluemountain</groupId>
            <artifactId>feishu-bot-common</artifactId>
        </dependency>
        <!-- 鉴权模块 -->
        <dependency>
            <groupId>com.bluemountain</groupId>
            <artifactId>feishu-bot-auth</artifactId>
        </dependency>
        <!-- 插件框架 -->
        <dependency>
            <groupId>com.bluemountain</groupId>
            <artifactId>feishu-bot-plugin</artifactId>
        </dependency>
        <!-- 外部集成 -->
        <dependency>
            <groupId>com.bluemountain</groupId>
            <artifactId>feishu-bot-integration</artifactId>
        </dependency>
        <!-- 基础设施（core 层直接使用 Redis/MQ/DB） -->
        <dependency>
            <groupId>com.bluemountain</groupId>
            <artifactId>feishu-bot-infrastructure</artifactId>
        </dependency>

        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
    </dependencies>
</project>
